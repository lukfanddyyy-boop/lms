CREATE DATABASE IF NOT EXISTS lms_modul_ajar
  CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

USE lms_modul_ajar;

-- Users
CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(50) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    nama_asli VARCHAR(100) DEFAULT NULL,
    kelas VARCHAR(20) DEFAULT NULL,
    role ENUM('admin','siswa') DEFAULT 'siswa',
    must_change_password TINYINT(1) DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

-- Modul (learning modules)
CREATE TABLE modul (
    id INT AUTO_INCREMENT PRIMARY KEY,
    judul VARCHAR(200) NOT NULL,
    deskripsi TEXT,
    konten LONGTEXT,
    kategori VARCHAR(50) DEFAULT 'Umum',
    level ENUM('Pemula','Menengah','Lanjutan') DEFAULT 'Pemula',
    materi_tag VARCHAR(100) DEFAULT NULL,
    urutan INT DEFAULT 0,
    aktif TINYINT(1) DEFAULT 1,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB;

-- Soal (questions)
CREATE TABLE soal (
    id INT AUTO_INCREMENT PRIMARY KEY,
    modul_id INT DEFAULT NULL,
    jenis ENUM('pilihan_ganda','isian_pendek') DEFAULT 'pilihan_ganda',
    pertanyaan TEXT NOT NULL,
    pilihan_a VARCHAR(255) DEFAULT NULL,
    pilihan_b VARCHAR(255) DEFAULT NULL,
    pilihan_c VARCHAR(255) DEFAULT NULL,
    pilihan_d VARCHAR(255) DEFAULT NULL,
    pilihan_e VARCHAR(255) DEFAULT NULL,
    jawaban_benar VARCHAR(5) DEFAULT NULL,
    jawaban_diterima TEXT DEFAULT NULL,
    pembahasan TEXT DEFAULT NULL,
    kategori VARCHAR(50) DEFAULT 'Umum',
    level ENUM('Pemula','Menengah','Lanjutan') DEFAULT 'Pemula',
    materi_tag VARCHAR(100) DEFAULT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (modul_id) REFERENCES modul(id) ON DELETE SET NULL
) ENGINE=InnoDB;

-- Deploy / sesi kuis
CREATE TABLE sesi_kuis (
    id INT AUTO_INCREMENT PRIMARY KEY,
    label VARCHAR(200) NOT NULL,
    kategori VARCHAR(50) DEFAULT 'Umum',
    level ENUM('Pemula','Menengah','Lanjutan') DEFAULT 'Pemula',
    materi_tag VARCHAR(100) DEFAULT NULL,
    target_kelas TEXT DEFAULT NULL,
    durasi_menit INT DEFAULT 30,
    maks_percobaan INT DEFAULT 4,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

-- Hasil kuis
CREATE TABLE hasil_kuis (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    sesi_id INT NOT NULL,
    skor DECIMAL(5,2) DEFAULT 0,
    total_soal INT DEFAULT 0,
    benar INT DEFAULT 0,
    selesai_pada TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (sesi_id) REFERENCES sesi_kuis(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- Jawaban detail per soal
CREATE TABLE jawaban_detail (
    id INT AUTO_INCREMENT PRIMARY KEY,
    hasil_id INT NOT NULL,
    soal_id INT NOT NULL,
    jawaban_siswa VARCHAR(255),
    cocok TINYINT(1) DEFAULT 0,
    FOREIGN KEY (hasil_id) REFERENCES hasil_kuis(id) ON DELETE CASCADE,
    FOREIGN KEY (soal_id) REFERENCES soal(id) ON DELETE CASCADE
) ENGINE=InnoDB;

-- Registrasi toggle
CREATE TABLE settings (
    `key` VARCHAR(50) PRIMARY KEY,
    `value` VARCHAR(255) DEFAULT NULL
) ENGINE=InnoDB;

